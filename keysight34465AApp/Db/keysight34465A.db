#-----------------------------------------------------------------
# Temperature transducer
#-----------------------------------------------------------------
record(mbbo, "$(P):$(R):TEMP_TYPE") {
    field(DESC, "Temperature transducer")
    field(DTYP, "stream")
    field(OUT,  "@keysight34465A.proto setTempType $(PORT)")
    field(SDIS, "$(P):$(R):HAS_TEMP")
    field(DISV, "0")
    field(ZRST, "4W RTD")
    field(ONST, "2W RTD")
    field(TWST, "4W Thermistor")
    field(THST, "2W Thermistor")
    field(FRST, "Thermocouple")
    field(FLNK, "$(P):$(R):REFRESH")
}
record(mbbi, "$(P):$(R):TEMP_TYPE_RB") {
    field(DTYP, "stream")
    field(INP,  "@keysight34465A.proto getTempType $(PORT)")
    field(SDIS, "$(P):$(R):HAS_TEMP")
    field(DISV, "0")
    field(ZRST, "4W RTD")
    field(ONST, "2W RTD")
    field(TWST, "4W Thermistor")
    field(THST, "2W Thermistor")
    field(FRST, "Thermocouple")
}

#-----------------------------------------------------------------
# Trigger and sample count
#-----------------------------------------------------------------
record(mbbo, "$(P):$(R):TRIG_SRC") {
    field(DESC, "Trigger source")
    field(DTYP, "stream")
    field(OUT,  "@keysight34465A.proto setTrigSrc $(PORT)")
    field(ZRST, "Immediate")
    field(ONST, "External")
    field(FLNK, "$(P):$(R):REFRESH")
}
record(mbbi, "$(P):$(R):TRIG_SRC_RB") {
    field(DTYP, "stream")
    field(INP,  "@keysight34465A.proto getTrigSrc $(PORT)")
    field(ZRST, "Immediate")
    field(ONST, "External")
    field(TWST, "Bus")
    field(THST, "Internal")
}

record(mbbo, "$(P):$(R):TRIG_SLOPE") {
    field(DESC, "Ext trigger slope")
    field(DTYP, "stream")
    field(OUT,  "@keysight34465A.proto setTrigSlope $(PORT)")
    field(ZRST, "Positive")
    field(ONST, "Negative")
    field(FLNK, "$(P):$(R):REFRESH")
}
record(mbbi, "$(P):$(R):TRIG_SLOPE_RB") {
    field(DTYP, "stream")
    field(INP,  "@keysight34465A.proto getTrigSlope $(PORT)")
    field(ZRST, "Positive")
    field(ONST, "Negative")
}

record(ao, "$(P):$(R):TRIG_DEL") {
    field(DESC, "Trigger delay (disables auto)")
    field(DTYP, "stream")
    field(OUT,  "@keysight34465A.proto setTrigDel $(PORT)")
    field(EGU,  "s")
    field(PREC, "6")
    field(DRVL, "0")
    field(DRVH, "3600")
    field(FLNK, "$(P):$(R):REFRESH")
}
record(ai, "$(P):$(R):TRIG_DEL_RB") {
    field(DTYP, "stream")
    field(INP,  "@keysight34465A.proto getTrigDel $(PORT)")
    field(EGU,  "s")
    field(PREC, "6")
}

record(bo, "$(P):$(R):TRIG_DEL_AUTO") {
    field(DESC, "Auto trigger delay")
    field(DTYP, "stream")
    field(OUT,  "@keysight34465A.proto setTrigDelAuto $(PORT)")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(FLNK, "$(P):$(R):REFRESH")
}
record(bi, "$(P):$(R):TRIG_DEL_AUTO_RB") {
    field(DTYP, "stream")
    field(INP,  "@keysight34465A.proto getTrigDelAuto $(PORT)")
    field(ZNAM, "Off")
    field(ONAM, "On")
}

# TRIG_COUNT x SAMP_COUNT must not exceed NELM
record(longout, "$(P):$(R):TRIG_COUNT") {
    field(DESC, "Triggers per READ?")
    field(DTYP, "stream")
    field(OUT,  "@keysight34465A.proto setTrigCount $(PORT)")
    field(VAL,  "1")
    field(DRVL, "1")
    field(DRVH, "$(NELM=1000)")
    field(FLNK, "$(P):$(R):REFRESH")
}
record(ai, "$(P):$(R):TRIG_COUNT_RB") {
    field(DTYP, "stream")
    field(INP,  "@keysight34465A.proto getTrigCount $(PORT)")
    field(PREC, "0")
}

record(longout, "$(P):$(R):SAMP_COUNT") {
    field(DESC, "Samples per trigger")
    field(DTYP, "stream")
    field(OUT,  "@keysight34465A.proto setSampCount $(PORT)")
    field(DRVL, "1")
    field(DRVH, "$(NELM=1000)")
    field(FLNK, "$(P):$(R):REFRESH")
}
record(longin, "$(P):$(R):SAMP_COUNT_RB") {
    field(DTYP, "stream")
    field(INP,  "@keysight34465A.proto getSampCount $(PORT)")
}

#-----------------------------------------------------------------
# Acquisition
#   READ_ARR (READ?) -> STATS (aSub) -> VAL, MEAN, STD, MIN, MAX, NVALID, OVLD
#   Change READ_ARR.SCAN to set the rate, or set it Passive and use TRIGGER.
#-----------------------------------------------------------------
record(bo, "$(P):$(R):ACQ_EN") {
    field(DESC, "Enable periodic acquisition")
    field(ZNAM, "Disabled")
    field(ONAM, "Enabled")
    field(VAL,  "$(ACQ_EN=1)")
    field(PINI, "YES")
}

record(bo, "$(P):$(R):TRIGGER") {
    field(DESC, "Single acquisition")
    field(OUT,  "$(P):$(R):READ_ARR.PROC PP")
    field(ZNAM, "Acquire")
    field(ONAM, "Acquire")
}

record(waveform, "$(P):$(R):READ_ARR") {
    field(DESC, "Readings of last READ?")
    field(DTYP, "stream")
    field(INP,  "@keysight34465A.proto readArray $(PORT)")
    field(SCAN, "$(SCAN=1 second)")
    field(SDIS, "$(P):$(R):ACQ_EN")
    field(DISV, "0")
    field(FTVL, "DOUBLE")
    field(NELM, "$(NELM=1000)")
    field(PREC, "7")
    field(FLNK, "$(P):$(R):STATS")
}

record(aSub, "$(P):$(R):STATS") {
    field(DESC, "Reading statistics")
    field(SNAM, "keysightStats")
    field(INPA, "$(P):$(R):READ_ARR NPP MS")
    field(FTA,  "DOUBLE")
    field(NOA,  "$(NELM=1000)")
    field(FTVA, "DOUBLE")
    field(FTVB, "DOUBLE")
    field(FTVC, "DOUBLE")
    field(FTVD, "DOUBLE")
    field(FTVE, "DOUBLE")
    field(FTVF, "LONG")
    field(FTVG, "LONG")
    field(OUTA, "$(P):$(R):VAL PP MS")
    field(OUTB, "$(P):$(R):MEAN PP MS")
    field(OUTC, "$(P):$(R):STD PP MS")
    field(OUTD, "$(P):$(R):MIN PP MS")
    field(OUTE, "$(P):$(R):MAX PP MS")
    field(OUTF, "$(P):$(R):NVALID PP MS")
    field(OUTG, "$(P):$(R):OVLD PP MS")
    field(FLNK, "$(P):$(R):CONV_FAN")
}

record(ai, "$(P):$(R):VAL") {
    field(DESC, "Last reading")
    field(PREC, "7")
}
record(ai, "$(P):$(R):MEAN") {
    field(DESC, "Mean of readings")
    field(PREC, "7")
}
record(ai, "$(P):$(R):STD") {
    field(DESC, "Std deviation of readings")
    field(PREC, "7")
}
record(ai, "$(P):$(R):MIN") {
    field(DESC, "Min of readings")
    field(PREC, "7")
}
record(ai, "$(P):$(R):MAX") {
    field(DESC, "Max of readings")
    field(PREC, "7")
}
record(longin, "$(P):$(R):NVALID") {
    field(DESC, "Valid readings in array")
}
record(bi, "$(P):$(R):OVLD") {
    field(DESC, "Overload in last READ?")
    field(ZNAM, "OK")
    field(ONAM, "OVERLOAD")
    field(OSV,  "MAJOR")
}

#-----------------------------------------------------------------
# User conversion to a derived quantity
#   CONV_x = x * CONV_FACTOR + CONV_OFFSET     (x = VAL, MEAN, MIN, MAX)
#   CONV_STD = STD * |CONV_FACTOR|
# e.g. charge from an integrator output: FACTOR = C[F] * 1e12, EGU = pC
# Recomputed after every acquisition and when factor/offset change.
#-----------------------------------------------------------------
record(ao, "$(P):$(R):CONV_FACTOR") {
    field(DESC, "Conversion factor")
    field(VAL,  "$(CONV_FACTOR=1)")
    field(PREC, "6")
    field(PINI, "YES")
    field(FLNK, "$(P):$(R):CONV_FAN")
}
record(ao, "$(P):$(R):CONV_OFFSET") {
    field(DESC, "Conversion offset")
    field(VAL,  "$(CONV_OFFSET=0)")
    field(PREC, "6")
    field(PINI, "YES")
    field(FLNK, "$(P):$(R):CONV_FAN")
}
record(stringout, "$(P):$(R):CONV_EGU") {
    field(DESC, "Unit of converted value")
    field(VAL,  "$(CONV_EGU=)")
    field(PINI, "YES")
    field(FLNK, "$(P):$(R):CEGU_VAL")
}

record(fanout, "$(P):$(R):CONV_FAN") {
    field(SELM, "All")
    field(LNK0, "$(P):$(R):CONV_VAL")
    field(LNK1, "$(P):$(R):CONV_MEAN")
    field(LNK2, "$(P):$(R):CONV_STD")
    field(LNK3, "$(P):$(R):CONV_MIN")
    field(LNK4, "$(P):$(R):CONV_MAX")
}

record(calc, "$(P):$(R):CONV_VAL") {
    field(DESC, "Converted last reading")
    field(INPA, "$(P):$(R):VAL MS")
    field(INPF, "$(P):$(R):CONV_FACTOR")
    field(INPG, "$(P):$(R):CONV_OFFSET")
    field(CALC, "A*F+G")
    field(PREC, "$(CONV_PREC=4)")
}
record(calc, "$(P):$(R):CONV_MEAN") {
    field(DESC, "Converted mean")
    field(INPA, "$(P):$(R):MEAN MS")
    field(INPF, "$(P):$(R):CONV_FACTOR")
    field(INPG, "$(P):$(R):CONV_OFFSET")
    field(CALC, "A*F+G")
    field(PREC, "$(CONV_PREC=4)")
}
record(calc, "$(P):$(R):CONV_STD") {
    field(DESC, "Converted std deviation")
    field(INPA, "$(P):$(R):STD MS")
    field(INPF, "$(P):$(R):CONV_FACTOR")
    field(CALC, "A*ABS(F)")
    field(PREC, "$(CONV_PREC=4)")
}
# a negative factor swaps min and max
record(calc, "$(P):$(R):CONV_MIN") {
    field(DESC, "Converted min")
    field(INPA, "$(P):$(R):MIN MS")
    field(INPB, "$(P):$(R):MAX MS")
    field(INPF, "$(P):$(R):CONV_FACTOR")
    field(INPG, "$(P):$(R):CONV_OFFSET")
    field(CALC, "MIN(A*F+G,B*F+G)")
    field(PREC, "$(CONV_PREC=4)")
}
record(calc, "$(P):$(R):CONV_MAX") {
    field(DESC, "Converted max")
    field(INPA, "$(P):$(R):MIN MS")
    field(INPB, "$(P):$(R):MAX MS")
    field(INPF, "$(P):$(R):CONV_FACTOR")
    field(INPG, "$(P):$(R):CONV_OFFSET")
    field(CALC, "MAX(A*F+G,B*F+G)")
    field(PREC, "$(CONV_PREC=4)")
}

# Propagate CONV_EGU to the converted records
record(stringout, "$(P):$(R):CEGU_VAL") {
    field(DOL,  "$(P):$(R):CONV_EGU")
    field(OMSL, "closed_loop")
    field(OUT,  "$(P):$(R):CONV_VAL.EGU")
    field(FLNK, "$(P):$(R):CEGU_MEAN")
}
record(stringout, "$(P):$(R):CEGU_MEAN") {
    field(DOL,  "$(P):$(R):CONV_EGU")
    field(OMSL, "closed_loop")
    field(OUT,  "$(P):$(R):CONV_MEAN.EGU")
    field(FLNK, "$(P):$(R):CEGU_STD")
}
record(stringout, "$(P):$(R):CEGU_STD") {
    field(DOL,  "$(P):$(R):CONV_EGU")
    field(OMSL, "closed_loop")
    field(OUT,  "$(P):$(R):CONV_STD.EGU")
    field(FLNK, "$(P):$(R):CEGU_MIN")
}
record(stringout, "$(P):$(R):CEGU_MIN") {
    field(DOL,  "$(P):$(R):CONV_EGU")
    field(OMSL, "closed_loop")
    field(OUT,  "$(P):$(R):CONV_MIN.EGU")
    field(FLNK, "$(P):$(R):CEGU_MAX")
}
record(stringout, "$(P):$(R):CEGU_MAX") {
    field(DOL,  "$(P):$(R):CONV_EGU")
    field(OMSL, "closed_loop")
    field(OUT,  "$(P):$(R):CONV_MAX.EGU")
}
